# Walmart API 凭证（仅服务端使用，密钥绝不进代码 / 前端）
# 复制本文件为 .env 并在本地运行；部署到 Render 时直接在面板填写同名环境变量
WALMART_CLIENT_ID=你的_client_id
WALMART_CLIENT_SECRET=你的_client_secret

# 可选：代理（服务器在境外或国内网络需要时使用）
WALMART_PROXY=

# 可选：限定允许跨域调用的前端域名，如 https://你的用户名.github.io
# 留空表示放行所有来源（仅建议个人使用）
ALLOWED_ORIGINS=

# 可选：设为 1 使用 sandbox 测试环境
WALMART_SANDBOX=0
